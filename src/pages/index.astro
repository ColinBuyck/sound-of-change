---
import Layout from "../layouts/Layout.astro";
import Papa from "papaparse";
import fs from "node:fs";
import { JailConstructionChart } from "../components/JailConstructionChart";

export interface JailConstructionInfo {
  project_year: string;
  project_amount_clean: string;
}

const csvText = fs.readFileSync(
  "src/data/vera/jail_construction_costs_clean.csv",
  "utf-8",
);
const response: { data: JailConstructionInfo[] } = Papa.parse(csvText, {
  header: true,
});
---

<Layout>
  <JailConstructionChart data={response.data} client:load />
</Layout>
